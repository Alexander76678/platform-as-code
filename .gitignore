# ============================================
# Terraform
# ============================================
# Provider binaries and modules — regenerated by `terraform init`
**/.terraform/*

# State files — contain sensitive data, should live in remote backend
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs and plans
crash.log
crash.*.log
*.tfplan

# CLI config
.terraformrc
terraform.rc

# ============================================
# Ansible
# ============================================
*.retry
.vault_pass
# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
venv/
env/

# ============================================
# OS / IDE
# ============================================
.DS_Store
.vscode/
.idea/
*.swp

# ============================================
# App
# ============================================
.env
logs/.vault_pass
